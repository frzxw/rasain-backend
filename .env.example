# Copy this file to .env and replace every placeholder.
# Never commit .env. There is no default account.

# Supabase project (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Checked by the test suite. The API authenticates with Supabase sessions.
JWT_SECRET=replace-with-a-long-random-string

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional direct Postgres URL, for psql. The server talks to Supabase.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIRECTORY=uploads

# Logging
LOG_LEVEL=info

# Created by npm run db:migrate and npm run db:reset.
# Pick your own email and a unique password. Do not reuse a password from git history.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin

# Shared password for the three sample users created by npm run db:seed.
SEED_USER_PASSWORD=replace-with-a-sample-password
